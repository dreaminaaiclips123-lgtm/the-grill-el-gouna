# Database (Postgres/Neon). Vercel injects this automatically once a
# Postgres database is connected to this project under Storage in the
# Vercel dashboard (or `vercel integration add neon`, interactive only).
DATABASE_URL=

# WhatsApp Cloud API (Meta). Requires a Meta Business account with the
# WhatsApp Business Platform set up for this restaurant's number, plus a
# pre-approved message template for booking confirmations (business-initiated
# messages need an approved template outside the 24h chat window). See:
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=booking_confirmation

# The restaurant's own WhatsApp number (with country code, digits only),
# notified whenever a new booking comes in.
RESTAURANT_WHATSAPP_NUMBER=201221783333

# Password for /admin/bookings.
ADMIN_PASSWORD=
